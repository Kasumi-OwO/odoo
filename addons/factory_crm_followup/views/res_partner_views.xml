<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_factory_customer" model="ir.ui.view">
        <field name="name">res.partner.form.factory.customer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="is_factory_customer" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="factory_customer_profile" string="Factory Customer"
                      invisible="not is_factory_customer">
                    <button name="action_create_reactivation_opportunity"
                            type="object"
                            string="Create / Open Reactivation Opportunity"
                            icon="fa-refresh"
                            class="btn-primary mb-3"
                            groups="sales_team.group_sale_salesman"/>
                    <group>
                        <group string="Sales Profile">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="wechat"/>
                            <field name="factory_source"/>
                            <field name="customer_type"/>
                            <field name="purchase_cycle"/>
                            <field name="current_supplier"/>
                            <field name="customer_concerns"/>
                        </group>
                        <group string="Purchase Requirement">
                            <field name="logo_customization"/>
                            <field name="estimated_quantity"/>
                            <field name="legacy_buyer_demand"/>
                        </group>
                    </group>
                    <group>
                        <group string="Historical Buyer Information">
                            <field name="legacy_buyer_nickname"/>
                            <field name="legacy_shipping_phone" widget="phone"/>
                            <field name="legacy_buyer_identity"/>
                            <field name="legacy_buyer_level"/>
                            <field name="legacy_province"/>
                            <field name="legacy_city"/>
                        </group>
                        <group string="Historical Purchase Summary">
                            <field name="legacy_first_purchase_date"/>
                            <field name="legacy_latest_purchase_date"/>
                            <field name="legacy_days_since_purchase"/>
                            <field name="legacy_purchase_count"/>
                            <field name="legacy_total_purchase_amount"/>
                            <field name="factory_currency_id" invisible="1"/>
                            <field name="legacy_first_order_ad_driven"/>
                        </group>
                    </group>
                    <group string="Legacy Follow-up Information">
                        <group>
                            <field name="legacy_contact_name"/>
                            <field name="legacy_contact_details"/>
                            <field name="legacy_importance_level"/>
                            <field name="legacy_followup_method"/>
                        </group>
                        <group>
                            <field name="legacy_import_key" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_list_factory_customer" model="ir.ui.view">
        <field name="name">res.partner.list.factory.customer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="wechat" optional="hide"/>
                <field name="legacy_buyer_identity" optional="show"/>
                <field name="legacy_buyer_level" optional="show"/>
                <field name="legacy_purchase_count" optional="show"/>
                <field name="legacy_total_purchase_amount" optional="show"/>
                <field name="factory_currency_id" column_invisible="True"/>
                <field name="legacy_latest_purchase_date" optional="show"/>
                <field name="legacy_province" optional="hide"/>
                <field name="legacy_city" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="res_partner_view_search_factory_customer" model="ir.ui.view">
        <field name="name">res.partner.search.factory.customer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Factory Customers">
                <field name="name" filter_domain="[('display_name', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="wechat"/>
                <field name="legacy_buyer_nickname"/>
                <field name="legacy_shipping_phone"/>
                <field name="legacy_buyer_identity"/>
                <field name="legacy_buyer_level"/>
                <field name="legacy_province"/>
                <field name="legacy_city"/>
                <field name="user_id"/>
                <separator/>
                <filter name="factory_customer" string="Factory Customers"
                        domain="[('is_factory_customer', '=', True)]"/>
                <filter name="my_factory_customers" string="My Customers"
                        domain="[('is_factory_customer', '=', True), ('user_id', '=', uid)]"/>
                <filter name="unassigned_factory_customers" string="Unassigned Customers"
                        domain="[('is_factory_customer', '=', True), ('user_id', '=', False)]"/>
                <filter name="repeat_factory_customers" string="Repeat Customers"
                        domain="[('is_factory_customer', '=', True), ('legacy_purchase_count', '&gt;', 1)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="salesperson" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="factory_buyer_level_group" string="Buyer Level"
                            context="{'group_by': 'legacy_buyer_level'}"/>
                    <filter name="factory_province_group" string="Province"
                            context="{'group_by': 'legacy_province'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="factory_customer_action" model="ir.actions.act_window">
        <field name="name">Factory Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="domain">[('is_factory_customer', '=', True)]</field>
        <field name="context">{'default_is_factory_customer': True}</field>
        <field name="search_view_id" ref="res_partner_view_search_factory_customer"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a factory customer</p>
            <p>Assign a salesperson, review purchase history, then create a reactivation opportunity.</p>
        </field>
    </record>

    <menuitem id="factory_customer_menu"
              name="Factory Customers"
              parent="crm.crm_menu_sales"
              action="factory_customer_action"
              sequence="3"
              groups="sales_team.group_sale_salesman"/>
</odoo>
